# Copy to .env for local (non-docker-compose) runs, or set these in your shell.

DATABASE_URL=postgresql://compliancegpt:devpassword@localhost:5432/compliancegpt

# Leave both unset to run in retrieval-only mode (no LLM generation, just
# returns the retrieved source chunks) - useful for testing retrieval quality
# without a GPU, or before Ollama is set up.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
